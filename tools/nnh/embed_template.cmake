# Embeds a project template into nnh (spec 033 FR-7, D56 item 1): the listed files of SOURCE_DIR, in the order given,
# become one C++ source defining `const nnh::tool::TemplateFile <SYMBOL>[]` and `<SYMBOL>_count`
# (src/new/template_files.hpp). Text files have their line endings normalised to LF; images and sounds (.png, .wav) are
# copied byte for byte. "x.in" is written as "x" and rendered (placeholders); "gitignore"/"gitattributes" are written as
# dotfiles, so they never act on the engine repository.
#   cmake -DSOURCE_DIR=<template> -DOUTPUT=<file.cpp> -DSYMBOL=<name> "-DFILES=a|b/c.in|..." -P embed_template.cmake
cmake_minimum_required(VERSION 3.25)

string(REPLACE "|" ";" FILES "${FILES}")

set(body "")
set(table "")
set(index 0)
foreach(stored IN LISTS FILES)
    set(path "${SOURCE_DIR}/${stored}")
    if(NOT EXISTS "${path}")
        message(FATAL_ERROR "embed_template: ${path} is missing")
    endif()
    # The bytes as ",xx" tokens, so a CR LF pair can only match at a token boundary. (The normalisation stays in hex:
    # file(WRITE) is a text write on Windows.)
    file(READ "${path}" hex HEX)
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" ",\\1" tokens "${hex}")
    set(text false)
    if(NOT stored MATCHES "\\.(png|wav)$")
        set(text true)
        string(REPLACE ",0d,0a" ",0a" tokens "${tokens}")
    endif()
    string(LENGTH "${tokens}" length)
    math(EXPR size "${length} / 3")
    string(REGEX REPLACE ",([0-9a-f][0-9a-f])" "0x\\1," bytes "${tokens}")
    string(REGEX REPLACE "(0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,)"
           "\\1\n    " bytes "${bytes}") # 16 bytes a line
    string(APPEND body "const unsigned char ${SYMBOL}_bytes_${index}[] = {\n    ${bytes}0x00};\n")

    set(written "${stored}")
    set(render false)
    if(written MATCHES "\\.in$")
        string(REGEX REPLACE "\\.in$" "" written "${written}")
        set(render true)
    endif()
    if(written STREQUAL "gitignore" OR written STREQUAL "gitattributes")
        set(written ".${written}")
    endif()
    string(APPEND table "    {\"${stored}\", \"${written}\", ${SYMBOL}_bytes_${index}, ${size}u, ${text}, ${render}},\n")
    math(EXPR index "${index} + 1")
endforeach()

set(source "// Generated by tools/nnh/embed_template.cmake from ${SOURCE_DIR}: do not edit.\n\n")
string(APPEND source "#include \"new/template_files.hpp\"\n\nnamespace nnh::tool {\nnamespace {\n\n${body}\n")
string(APPEND source "} // namespace\n\nextern const TemplateFile ${SYMBOL}[] = {\n${table}};\n")
string(APPEND source "extern const std::size_t ${SYMBOL}_count = ${index};\n\n} // namespace nnh::tool\n")
file(WRITE "${OUTPUT}" "${source}")
