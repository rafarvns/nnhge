# ctest nnh_new_files (spec 033 FR-1 to FR-5, FR-11, AC-1, AC-9): the built nnh as a user runs it, in a scratch folder.
#   cmake -DNNH=<nnh executable> -DWORK=<scratch folder> -DENGINE=<this engine checkout> -P new_files.cmake
# NNHGE_ENGINE_DIR is unset by the test's properties.

file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}")
set(failures 0)

# run(<expected exit> <regex the output must match> args...)
function(run want match)
    execute_process(COMMAND "${NNH}" ${ARGN} WORKING_DIRECTORY "${WORK}" RESULT_VARIABLE rc OUTPUT_VARIABLE out
                    ERROR_VARIABLE out TIMEOUT 60)
    if(NOT rc EQUAL want OR NOT out MATCHES "${match}")
        message("nnh ${ARGN}: exit ${rc} (expected ${want}), output:\n${out}\n(expected to match: ${match})")
        math(EXPR failures "${failures} + 1")
        set(failures ${failures} PARENT_SCOPE)
    endif()
    set(last_output "${out}" PARENT_SCOPE)
endfunction()

function(listing dir out_var)
    file(GLOB_RECURSE files LIST_DIRECTORIES false RELATIVE "${dir}" "${dir}/*")
    list(SORT files)
    set(${out_var} "${files}" PARENT_SCOPE)
endfunction()

run(0 "^nnh [0-9]+\\.[0-9]+\\.[0-9]+ \\(protocol [0-9]+, link [0-9]+, [a-z]+-[a-z0-9]+, (release build|from a source checkout)\\)\n$" --version)
run(0 "nnh new <name>.*nnh doctor.*nnh --version" help)
run(2 "unknown option '--fast' for nnh new" new demo --fast)
run(2 "which name" new)
run(1 "\"My Game\" can't be a game name: only lowercase letters, digits, '_' and '-' \\(try my-game\\)" new "My Game")
run(1 "can't be a game name: it contains a path separator" new ../escape)
run(1 "outside the homebrew range" new demo --unique-id 0x100)
run(1 "is not an NNHGE engine folder.*nothing was created" new demo --engine "${WORK}")
listing("${WORK}" empty)
if(empty)
    message("refusals created files: ${empty}")
    math(EXPR failures "${failures} + 1")
endif()

# A project, with the next commands and the local engine's lines (a checkout nnh, the variable unset).
run(0 "nnh: created demo/ \\(12 files; CIA UNIQUE_ID 0x[0-9A-F]+\\).*NNHGE_ENGINE_DIR.*next:\n  cd demo\n  nnh run demo --pc\n  nnh run demo "
    new demo --title "Demo Game" --engine "${ENGINE}")
listing("${WORK}/demo" got)
set(want .gitattributes .gitignore CMakeLists.txt CMakePresets.json README.md assets/art/player.png
         assets/sfx/blip.wav nnh.toml src/main.cpp src/scenes/play_scene.cpp src/scenes/play_scene.hpp tests/smoke.nnhs)
list(SORT want)
if(NOT got STREQUAL want)
    message("demo/ holds:\n  ${got}\nexpected:\n  ${want}")
    math(EXPR failures "${failures} + 1")
endif()
file(READ "${WORK}/demo/CMakeLists.txt" cmakelists)
if(NOT cmakelists MATCHES "TITLE \"Demo Game\"" OR cmakelists MATCHES "${ENGINE}")
    message("demo/CMakeLists.txt: no title, or the local engine's path in it")
    math(EXPR failures "${failures} + 1")
endif()
run(1 "demo exists and is not empty: nothing was changed" new demo --engine "${ENGINE}")

# The same inputs give the same bytes; the random ID differs between two runs (a 1 in 1,015,040 false alarm).
run(0 "created again/" new again --title "Demo Game" --engine "${ENGINE}" --unique-id 0x12345)
run(0 "created again2/" new again2 --title "Demo Game" --engine "${ENGINE}" --unique-id 0x12345)
file(READ "${WORK}/again/CMakeLists.txt" a)
file(READ "${WORK}/again2/CMakeLists.txt" b)
string(REPLACE "again2" "again" b "${b}")
if(NOT a STREQUAL b)
    message("two runs with the same inputs wrote different CMakeLists.txt")
    math(EXPR failures "${failures} + 1")
endif()
foreach(f src/main.cpp src/scenes/play_scene.cpp assets/art/player.png assets/sfx/blip.wav CMakePresets.json)
    file(SHA256 "${WORK}/again/${f}" ha)
    file(SHA256 "${WORK}/again2/${f}" hb)
    if(NOT ha STREQUAL hb)
        message("two runs wrote different ${f}")
        math(EXPR failures "${failures} + 1")
    endif()
endforeach()
run(0 "created r1/" new r1 --engine "${ENGINE}")
string(REGEX MATCH "UNIQUE_ID 0x[0-9A-F]+" id1 "${last_output}")
run(0 "created r2/" new r2 --engine "${ENGINE}")
string(REGEX MATCH "UNIQUE_ID 0x[0-9A-F]+" id2 "${last_output}")
if(id1 STREQUAL id2)
    run(0 "created r3/" new r3 --engine "${ENGINE}") # once more before calling it a fixed seed
    string(REGEX MATCH "UNIQUE_ID 0x[0-9A-F]+" id2 "${last_output}")
    if(id1 STREQUAL id2)
        message("three runs drew the same unique ID: ${id1}")
        math(EXPR failures "${failures} + 1")
    endif()
endif()

if(failures GREATER 0)
    message(FATAL_ERROR "nnh_new_files: ${failures} check(s) failed")
endif()
file(REMOVE_RECURSE "${WORK}")
message(STATUS "nnh_new_files: every check passed")
