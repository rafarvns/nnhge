# Spec 012 T7.4, automatic (spec 013): level 1 (made in Tiled) scrolling, the bonus level (built in code), the flip
# test, then the replay, which must play exactly as on the PC and at 60 Hz.
# PC:      nnh run platformer --pc --script examples/platformer/tests/level.nnhs
# Console: nnh run platformer --script examples/platformer/tests/level.nnhs   (Homebrew Launcher open, press Y)
# Screenshots are taken outside the replay (a screenshot frame is slow on the console). About 40 seconds.
#
# The replay's checksum lines below are the PC's (pc-debug). They change whenever the level, the bonus level, the
# player's physics or the replay's script change: run `PLATFORMER_DEMO=replay NNH_EXIT_AFTER_FRAMES=920
# build/pc-debug/examples/platformer/platformer.exe` and copy its `replay: ... sum` lines here (the last one up
# to its colon). The ctest
# platformer_replay_matches_script fails until they match. Last regenerated by spec 018 T7.1: the camera got a
# dead zone, smoothing on y, a look-ahead and a landing shake, and the camera is part of each sample's checksum.
fail-on "] E "
fail-on "replay: stopped"
fail-on "replay: 60 Hz FAIL"

# Level 1: the start (camera at the left edge), then the run of the replay with the buttons: the camera follows,
# the hills and clouds scroll slower than the ground (parallax), coins are taken.
wait 30
screenshot level1-start
press RIGHT
wait 40
tap A            # up onto the first plank
wait 88
tap A            # over the first pit
wait 148
tap A            # over the second pit
wait 50
screenshot level1-parallax
wait 57
tap A            # onto the bridge
wait 40
screenshot level1-bridge
release RIGHT

# The bonus level (SELECT), built in code.
tap SELECT
wait 30
press RIGHT
wait 60
screenshot bonus
release RIGHT

# The flip test (SELECT twice: bonus -> benchmark -> flips), then back to level 1 (SELECT).
tap SELECT
wait 10
tap SELECT
wait 30
screenshot flips
tap SELECT
wait 30

# The replay (X): level 1 for 600 frames, then the bonus level for 300, no buttons. Each checksum line must be
# the PC's; the game judges 60 Hz itself (a frame over 25 ms missed) and logs PASS or FAIL on the last line.
tap X
expect "replay: started" 10
expect "replay: 60 level1 x 121 y 242 coins 1 sum 0CF7E4CE" 120
expect "replay: 120 level1 x 226 y 210 coins 5 sum 712D6080" 120
expect "replay: 180 level1 x 331 y 213 coins 5 sum B81241F7" 120
expect "replay: 240 level1 x 436 y 226 coins 5 sum 334BB1A5" 120
expect "replay: 300 level1 x 541 y 226 coins 5 sum 47219250" 120
expect "replay: 360 level1 x 646 y 242 coins 5 sum CC2AA785" 120
expect "replay: 420 level1 x 751 y 202 coins 5 sum 27D1EDDA" 120
expect "replay: 480 level1 x 856 y 210 coins 10 sum A8162475" 120
expect "replay: 540 level1 x 891 y 242 coins 10 sum 1100B98D" 120
expect "replay: 600 level1 x 950 y 210 coins 10 sum 8E234F2C" 120
expect "replay: 660 bonus x 122 y 144 coins 0 sum CFF54129" 120
expect "replay: 720 bonus x 227 y 178 coins 0 sum A1A13061" 120
expect "replay: 780 bonus x 332 y 134 coins 0 sum 8607A3AD" 120
expect "replay: 840 bonus x 437 y 162 coins 0 sum 23D5768C" 120
expect "replay: done 900 frames sum 7CA9B256: 60 Hz PASS" 120
wait 15
screenshot replay-result
end
