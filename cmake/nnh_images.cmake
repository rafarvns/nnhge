# nnh_add_images(<target> <png files...>)
#
# Embeds images in a game (decision D19; called by nnh_add_game(... IMAGES ...)). For each image, one
# build step that only reruns when that image changes:
#   1. nnh_check_image.cmake: PNG with power-of-two sides from 8 to 1024, or the build fails naming it;
#   2. 3DS: tex3ds converts it to a .t3x GPU texture (RGBA8, compressed); PC: the PNG is kept as is;
#   3. nnh_embed.cmake turns the result into a .cpp byte array.
# A registry file (written at configure time, only when the list changes) maps each name — the file
# name without folder and extension — to its bytes for nnh::load_texture().

include("${CMAKE_CURRENT_LIST_DIR}/nnh_platform.cmake")

function(nnh_add_images target)
    set(_cmake_dir "${CMAKE_CURRENT_FUNCTION_LIST_DIR}") # spec 032 FR-6: not the calling folder's
    nnh_platform(_platform "nnh_add_game(${target})")
    set(images ${ARGN})
    set(out_dir "${CMAKE_CURRENT_BINARY_DIR}/nnh_images/${target}")
    file(MAKE_DIRECTORY "${out_dir}")

    set(names "")
    set(sources "")
    set(declarations "")
    set(entries "")
    foreach(image IN LISTS images)
        get_filename_component(path "${image}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_SOURCE_DIR}")
        get_filename_component(name "${image}" NAME_WE)
        if(name IN_LIST names)
            message(FATAL_ERROR "nnh_add_game(${target}): two images are named \"${name}\" (names are file "
                                "names without folder and extension, and must be unique)")
        endif()
        list(APPEND names "${name}")
        string(MAKE_C_IDENTIFIER "${name}" symbol)
        set(stamp "${out_dir}/${symbol}.checked")
        set(cpp "${out_dir}/image_${symbol}.cpp")

        set(check_cmd ${CMAKE_COMMAND} -DIMAGE=${path} -DSTAMP=${stamp} -P ${_cmake_dir}/nnh_check_image.cmake)
        if(_platform STREQUAL "3ds")
            if(NOT CTR_TEX3DS_EXE)
                message(FATAL_ERROR "nnh_add_game(${target}): tex3ds not found (install it with devkitPro)")
            endif()
            set(data "${out_dir}/${symbol}.t3x")
            set(convert_cmd COMMAND ${CTR_TEX3DS_EXE} -f rgba8888 -z auto -o ${data} ${path})
        else()
            set(data "${path}")
            set(convert_cmd "")
        endif()
        add_custom_command(
            OUTPUT "${cpp}"
            COMMAND ${check_cmd}
            ${convert_cmd}
            COMMAND ${CMAKE_COMMAND} -DINPUT=${data} -DOUTPUT=${cpp} -DSYMBOL=${symbol}
                    -P ${_cmake_dir}/nnh_embed.cmake
            DEPENDS "${path}" "${_cmake_dir}/nnh_check_image.cmake" "${_cmake_dir}/nnh_embed.cmake"
            COMMENT "Image ${name}"
            VERBATIM)
        list(APPEND sources "${cpp}")
        string(APPEND declarations
               "extern const unsigned char nnh_image_${symbol}[];\nextern const std::size_t nnh_image_${symbol}_size;\n")
        string(APPEND entries "    {\"${name}\", nnh_image_${symbol}, nnh_image_${symbol}_size},\n")
    endforeach()

    set(registry "${out_dir}/images.cpp")
    file(WRITE "${registry}.new" "// Generated by cmake/nnh_images.cmake for ${target}. Do not edit.
#include <cstddef>

#include \"nnh/detail/image_registry.hpp\"

${declarations}
namespace {
const nnh::detail::EmbeddedImage kImages[] = {
${entries}};
} // namespace

const nnh::detail::EmbeddedImage* nnh::detail::embedded_images(int& count) {
    count = static_cast<int>(sizeof kImages / sizeof kImages[0]);
    return kImages;
}
")
    file(COPY_FILE "${registry}.new" "${registry}" ONLY_IF_DIFFERENT)
    target_sources(${target} PRIVATE "${registry}" ${sources})
endfunction()
