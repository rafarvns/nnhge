# Spec 030 AC-3: the panel by buttons and by touch, on the PC (--pc) and the console.
#   nnh run live [--pc] --script examples/live/tests/panel.nnhs
# Rows with every group closed: colors, debug, fx, player, spawn (a row is 22 pixels from y 14 on the bottom screen).
fail-on "] E "
wait 30
expect-value player/state == "idle"
# the overlay (SELECT + L), then the Tunables page (SELECT + R): the panel takes the controls
wait 10
press SELECT
tap L
tap R
release SELECT
wait 2
# A opens and closes the colors group; the game never sees it
tap A
tap A
wait 10
expect-value player/state == "idle"
# player: open it, select jump
wait 10
tap DOWN
tap DOWN
tap DOWN
tap A
tap DOWN
tap DOWN
tap RIGHT
wait 2
expect-value player/jump == 5.75
wait 10
press R
tap RIGHT
release R
wait 2
expect-value player/jump == 8.25
wait 10
press L
tap RIGHT
tap RIGHT
tap RIGHT
release L
wait 2
expect-value player/jump == 12
wait 10
screenshot tunables
# respawn: an action on A
tap DOWN
tap A
expect "live: respawn" 10
wait 10
# colors/sky: open colors, A picks the green channel, right raises it
tap UP
tap UP
tap UP
tap UP
tap UP
tap UP
tap A
tap DOWN
tap DOWN
tap A
tap RIGHT
wait 2
expect-value colors/sky == "#4679C8FF"
wait 10
screenshot colour
# close colors (B: back on its row, the list scrolled to the top)
tap B
wait 2
# touch: the debug group row opens, a tap on hitboxes' value toggles it
touch 40 41
wait 1
untouch
wait 2
touch 220 62
wait 1
untouch
wait 2
expect-value debug/hitboxes == true
# a drag across jump's bar (row 6, its bar from x 16, 162 wide): the middle is 6
wait 10
touch 16 161
drag 97 161 4
untouch
wait 2
expect-value player/jump == 6
# `+` on the jump row
wait 10
touch 296 150
wait 1
untouch
wait 2
expect-value player/jump == 6.25
# the Watches page
wait 10
press SELECT
tap R
release SELECT
wait 2
screenshot watches
press SELECT
tap R
tap R
release SELECT
wait 2
# A held while the overlay closes stays blocked until released
press A
wait 5
press SELECT
tap L
release SELECT
wait 10
expect-value player/state == "idle"
wait 10
release A
wait 2
tap A
expect "live: jump" 10
wait 10
end
