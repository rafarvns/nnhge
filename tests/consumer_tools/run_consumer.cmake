# The consumer tests' driver (spec 032 FR-16, AC-1, AC-2, AC-5, AC-7, AC-13): builds tests/consumer against the engine
# in one way, runs its games headless and checks what a game project must (and must not) get.
#   cmake -DWAY=<way> -DENGINE=<engine dir> -DWORK=<scratch dir> -DPARENT=<the engine's own build dir>
#         -DGENERATOR=... -DMAKE_PROGRAM=... -DC_COMPILER=... -DCXX_COMPILER=... -DBUILD_TYPE=... [-DCCACHE=...]
#         [-DSDL3_SOURCE=<the parent's SDL3 download>] [-DEXPECT_LINE=<self-check line>] -P run_consumer.cmake
# WAY: local (FETCHCONTENT_SOURCE_DIR_NNHGE = the engine folder), archive (file:// tarball + SHA-256, git disabled),
#      archive_override (the same pin + the unpacked copy as the override), submodule (add_subdirectory of a clone of
#      the engine's committed HEAD), pruned (add_subdirectory of a copy without examples/tests/apps/specs/docs),
#      bad_hash (a wrong SHA-256 fails the configure), options_on (the engine's four part options ON, configure only).
# The ways other than local delete their folder once they pass (disk); local keeps it (incremental reruns).
cmake_minimum_required(VERSION 3.25)
include("${CMAKE_CURRENT_LIST_DIR}/consumer_engine.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/compare_flags.cmake")

set(FIXTURE "${CMAKE_CURRENT_LIST_DIR}/../consumer")
get_filename_component(FIXTURE "${FIXTURE}" ABSOLUTE)
set(BUILD "${WORK}/build")
file(STRINGS "${ENGINE}/CMakeLists.txt" _project REGEX "^project\\(nnhge VERSION ")
string(REGEX MATCH "VERSION ([0-9.]+)" _ "${_project}")
set(VERSION "${CMAKE_MATCH_1}")

# The headless run (like nnh_script_pc_smoke) and the compiler cache across folders (debug info holds the folder).
set(ENV{SDL_VIDEO_DRIVER} offscreen)
set(ENV{SDL_RENDER_DRIVER} software)
set(ENV{NNH_SIM_RENDERER} sdl)
set(ENV{SDL_AUDIO_DRIVER} dummy)
if(NOT DEFINED NOHASHDIR OR NOHASHDIR) # -DNOHASHDIR=0: measure without it (plan 032 T3.6)
    set(ENV{CCACHE_NOHASHDIR} 1)
endif()
set(SDL3_ARGS "")
if(SDL3_SOURCE) # reuse the parent's SDL3 download: no network in the tests
    set(SDL3_ARGS "-DFETCHCONTENT_SOURCE_DIR_NNH_SDL3_PREBUILT=${SDL3_SOURCE}" "-DFETCHCONTENT_SOURCE_DIR_NNH_SDL3=${SDL3_SOURCE}")
endif()

function(step what)
    execute_process(COMMAND ${ARGN} RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE out)
    set(step_output "${out}" PARENT_SCOPE)
    set(step_rc "${rc}" PARENT_SCOPE)
    if(NOT rc EQUAL 0 AND NOT ALLOW_FAILURE)
        message("${out}")
        message(FATAL_ERROR "consumer ${WAY}: ${what} failed (${rc})")
    endif()
endfunction()

function(configure)
    set(args -S "${FIXTURE}" -B "${BUILD}" -G "${GENERATOR}" "-DCMAKE_MAKE_PROGRAM=${MAKE_PROGRAM}"
        "-DCMAKE_C_COMPILER=${C_COMPILER}" "-DCMAKE_CXX_COMPILER=${CXX_COMPILER}" "-DCMAKE_BUILD_TYPE=${BUILD_TYPE}"
        "-DCONSUMER_EXPECT_VERSION=${VERSION}" -DCMAKE_EXPORT_COMPILE_COMMANDS=ON)
    list(APPEND args ${SDL3_ARGS})
    string(TIMESTAMP t0 "%s")
    step("configure" ${CMAKE_COMMAND} ${args} ${ARGN})
    string(TIMESTAMP t1 "%s")
    math(EXPR seconds "${t1} - ${t0}")
    message(STATUS "consumer ${WAY}: configured in ~${seconds} s")
    set(step_output "${step_output}" PARENT_SCOPE)
    set(step_rc "${step_rc}" PARENT_SCOPE)
endfunction()

function(build_and_run)
    step("build" ${CMAKE_COMMAND} --build "${BUILD}")
    set(ENV{NNH_EXIT_AFTER_FRAMES} 10)
    foreach(game nnh_consumer nnh_consumer_small)
        set(dir game)
        if(game STREQUAL "nnh_consumer_small")
            set(dir small)
        endif()
        file(GLOB exe "${BUILD}/${dir}/${game}" "${BUILD}/${dir}/${game}.exe")
        step("running ${game}" ${exe})
        set(out_${game} "${step_output}")
    endforeach()
    string(REGEX MATCH "consumer: [A-Z]+ [^\r\n]*" line "${out_nnh_consumer}")
    if(NOT line MATCHES "^consumer: PASS ")
        message("${out_nnh_consumer}")
        message(FATAL_ERROR "consumer ${WAY}: no PASS line (\"${line}\")")
    endif()
    if(EXPECT_LINE AND NOT line STREQUAL EXPECT_LINE)
        message(FATAL_ERROR "consumer ${WAY}: \"${line}\", expected \"${EXPECT_LINE}\"")
    endif()
    message(STATUS "consumer ${WAY}: ${line}")
endfunction()

# Only the game project's targets, tests and games (AC-1): no example, engine test, NNH Link or nnh target.
function(check_contents)
    step("listing targets" "${MAKE_PROGRAM}" -C "${BUILD}" -t targets all)
    string(REGEX MATCHALL "(^|\n)[^\n/:]+: phony" phony "${step_output}")
    set(names "")
    foreach(p IN LISTS phony)
        string(REGEX REPLACE "^\n?([^:]+): phony$" "\\1" n "${p}")
        list(APPEND names "${n}")
    endforeach()
    file(STRINGS "${PARENT}/nnh_games.txt" parent_games)
    set(forbidden nnh_tests nnh_tool_tests nnh_tool_lib nnh nnh-link nnh_link nnh_link_app_tests nnh_assetc_tests
                  nnh_test_framework nnh_fuzz_targets nnh_platform_fake)
    foreach(g IN LISTS parent_games)
        string(REGEX REPLACE "\\|.*" "" g "${g}")
        list(APPEND forbidden "${g}")
    endforeach()
    foreach(name IN LISTS forbidden)
        if(name IN_LIST names)
            message(FATAL_ERROR "consumer ${WAY}: the engine's target '${name}' is in the game project's build")
        endif()
    endforeach()
    step("ctest -N" ${CMAKE_CTEST_COMMAND} --test-dir "${BUILD}" -N)
    if(NOT step_output MATCHES "Total Tests: 1\n" OR NOT step_output MATCHES "consumer_own_test")
        message(FATAL_ERROR "consumer ${WAY}: ctest -N lists more than the project's own test:\n${step_output}")
    endif()
    file(STRINGS "${BUILD}/nnh_games.txt" games)
    list(TRANSFORM games REPLACE "\\|.*" "")
    list(SORT games)
    if(NOT games STREQUAL "nnh_consumer;nnh_consumer_small")
        message(FATAL_ERROR "consumer ${WAY}: nnh_games.txt lists '${games}'")
    endif()
endfunction()

# FR-7, FR-8, FR-10 (AC-7): the same compile settings as an in-repository game, the project's own library untouched,
# the engine's version in the parent's cache too.
function(check_settings)
    consumer_compile_line("${PARENT}" hello "examples/hello/main\\.cpp" hello_line)
    consumer_compile_line("${BUILD}" nnh_consumer_small "small/main\\.cpp" small_line)
    consumer_flags("${hello_line}" "${PARENT}" hello_flags)
    consumer_flags("${small_line}" "${BUILD}" small_flags)
    if(NOT hello_flags STREQUAL small_flags)
        message(FATAL_ERROR "consumer ${WAY}: the game's compile command differs from hello's:\n"
                            "  hello: ${hello_flags}\n  game:  ${small_flags}")
    endif()
    if(CCACHE AND NOT small_line MATCHES "ccache")
        message(FATAL_ERROR "consumer ${WAY}: no compiler cache on the game's compile: ${small_line}")
    endif()
    set(plain_build "${WORK}/plain_only")
    step("configuring plain_only" ${CMAKE_COMMAND} -S "${CMAKE_CURRENT_LIST_DIR}/plain_only" -B "${plain_build}"
         -G "${GENERATOR}" "-DCMAKE_MAKE_PROGRAM=${MAKE_PROGRAM}" "-DCMAKE_C_COMPILER=${C_COMPILER}"
         "-DCMAKE_CXX_COMPILER=${CXX_COMPILER}" "-DCMAKE_BUILD_TYPE=${BUILD_TYPE}")
    consumer_compile_line("${plain_build}" consumer_plain "plain\\.cpp" alone)
    consumer_compile_line("${BUILD}" consumer_plain "plain\\.cpp" with_engine)
    consumer_flags("${alone}" "${plain_build}" alone)
    consumer_flags("${with_engine}" "${BUILD}" with_engine)
    if(NOT alone STREQUAL with_engine)
        message(FATAL_ERROR "consumer ${WAY}: adding the engine changed the project's own library:\n"
                            "  alone:       ${alone}\n  with engine: ${with_engine}")
    endif()
    # A project that chose its own standard keeps it; -DNNH_CCACHE= (empty) turns the cache off (configure only).
    set(chosen "${WORK}/build_chosen")
    step("configuring with C++23 and no cache" ${CMAKE_COMMAND} -S "${FIXTURE}" -B "${chosen}" -G "${GENERATOR}"
         "-DCMAKE_MAKE_PROGRAM=${MAKE_PROGRAM}" "-DCMAKE_C_COMPILER=${C_COMPILER}" "-DCMAKE_CXX_COMPILER=${CXX_COMPILER}"
         "-DCMAKE_BUILD_TYPE=${BUILD_TYPE}" "-DFETCHCONTENT_SOURCE_DIR_NNHGE=${ENGINE}" -DCMAKE_CXX_STANDARD=23
         -DNNH_CCACHE= ${SDL3_ARGS})
    consumer_compile_line("${chosen}" nnh_consumer_small "small/main\\.cpp" chosen_line)
    if(NOT chosen_line MATCHES "-std=(c|gnu)\\+\\+23" OR chosen_line MATCHES "ccache")
        message(FATAL_ERROR "consumer ${WAY}: C++23 or the cache switch not kept on the game: ${chosen_line}")
    endif()
    file(REMOVE_RECURSE "${chosen}")
    file(STRINGS "${PARENT}/CMakeCache.txt" parent_version REGEX "^NNHGE_VERSION:")
    if(NOT parent_version MATCHES "=${VERSION}$")
        message(FATAL_ERROR "consumer ${WAY}: the engine's own build has '${parent_version}', expected ${VERSION}")
    endif()
endfunction()

# AC-5: building leaves the engine folder it used as it was (names, sizes, times).
function(build_keeping engine)
    consumer_listing("${engine}" before)
    build_and_run()
    consumer_listing("${engine}" after)
    if(NOT before STREQUAL after)
        message(FATAL_ERROR "consumer ${WAY}: the build changed the engine folder ${engine}")
    endif()
endfunction()

set(PIN_ARGS "")
if(WAY MATCHES "^(archive|archive_override|bad_hash)$")
    consumer_pack_engine("${ENGINE}" "${WORK}" url sha)
    set(PIN_ARGS "-DCONSUMER_ENGINE_URL=${url}" "-DCONSUMER_ENGINE_SHA256=${sha}")
endif()

if(WAY STREQUAL "local")
    # A fresh cache every run (the objects stay): option defaults and cache entries are checked as a new game project
    # gets them, not as an earlier run left them.
    file(REMOVE "${BUILD}/CMakeCache.txt")
    configure("-DFETCHCONTENT_SOURCE_DIR_NNHGE=${ENGINE}")
    build_and_run()
    check_contents()
    check_settings()
elseif(WAY STREQUAL "archive") # FR-1.1, FR-3: the pinned download, without git
    configure(${PIN_ARGS} -DCMAKE_DISABLE_FIND_PACKAGE_Git=ON)
    build_keeping("${BUILD}/_deps/nnhge-src")
    check_contents()
elseif(WAY STREQUAL "archive_override") # FR-1.2: the same pin, the local copy used instead
    file(MAKE_DIRECTORY "${WORK}/unpacked")
    step("unpacking" ${CMAKE_COMMAND} -E chdir "${WORK}/unpacked" ${CMAKE_COMMAND} -E tar xzf "${WORK}/nnhge.tar.gz")
    configure(${PIN_ARGS} "-DFETCHCONTENT_SOURCE_DIR_NNHGE=${WORK}/unpacked/nnhge")
    if(EXISTS "${BUILD}/_deps/nnhge-subbuild")
        message(FATAL_ERROR "consumer ${WAY}: the archive was downloaded although the override was set")
    endif()
    build_keeping("${WORK}/unpacked/nnhge")
elseif(WAY STREQUAL "submodule") # FR-1.3: add_subdirectory of a checkout (the committed HEAD)
    if(NOT EXISTS "${ENGINE}/.git")
        message(STATUS "consumer submodule: skipped (the engine folder has no .git)")
        file(REMOVE_RECURSE "${WORK}")
        return()
    endif()
    find_program(GIT_PROGRAM git REQUIRED)
    file(REMOVE_RECURSE "${WORK}/nnhge")
    step("cloning the engine" "${GIT_PROGRAM}" clone --quiet "${ENGINE}" "${WORK}/nnhge")
    configure(-DCONSUMER_WAY=subdir "-DCONSUMER_ENGINE_SUBDIR=${WORK}/nnhge")
    build_keeping("${WORK}/nnhge")
elseif(WAY STREQUAL "pruned") # FR-1.4, FR-5: a copy without the parts a game doesn't need
    consumer_copy_engine("${ENGINE}" "${WORK}/nnhge")
    file(REMOVE_RECURSE "${WORK}/nnhge/examples" "${WORK}/nnhge/tests" "${WORK}/nnhge/apps" "${WORK}/nnhge/specs"
                        "${WORK}/nnhge/docs")
    configure(-DCONSUMER_WAY=subdir "-DCONSUMER_ENGINE_SUBDIR=${WORK}/nnhge")
    build_keeping("${WORK}/nnhge")
    check_contents()
    set(BUILD "${WORK}/build_examples_on") # an option ON whose folder is missing: loud
    set(ALLOW_FAILURE ON)
    configure(-DCONSUMER_WAY=subdir "-DCONSUMER_ENGINE_SUBDIR=${WORK}/nnhge" -DNNH_BUILD_EXAMPLES=ON)
    string(REGEX REPLACE "[ \t\r\n]+" " " flat "${step_output}")
    if(step_rc EQUAL 0 OR NOT flat MATCHES "NNH_BUILD_EXAMPLES is ON but the engine has no examples/ folder")
        message(FATAL_ERROR "consumer ${WAY}: NNH_BUILD_EXAMPLES=ON without examples/ didn't fail as expected:\n${step_output}")
    endif()
elseif(WAY STREQUAL "bad_hash") # FR-2: a wrong SHA-256 fails the configure, naming the URL; nothing is built
    set(ALLOW_FAILURE ON)
    configure("-DCONSUMER_ENGINE_URL=${url}" "-DCONSUMER_ENGINE_SHA256=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef")
    # A download says "HASH mismatch"; a local file:// archive "SHA256 hash of <file> does not match expected value".
    string(REGEX REPLACE "[ \t\r\n]+" " " flat "${step_output}")
    if(step_rc EQUAL 0 OR NOT flat MATCHES "HASH mismatch|does not match expected value" OR NOT flat MATCHES "nnhge\\.tar\\.gz")
        message(FATAL_ERROR "consumer ${WAY}: a wrong hash didn't fail naming the archive:\n${step_output}")
    endif()
    file(GLOB built "${BUILD}/game/nnh_consumer*")
    if(built OR EXISTS "${BUILD}/_deps/nnhge-src/CMakeLists.txt")
        message(FATAL_ERROR "consumer ${WAY}: something was unpacked or built from the unverified archive: ${built}")
    endif()
elseif(WAY STREQUAL "options_on") # AC-13: every optional part asked for by the game project (configure only)
    configure("-DFETCHCONTENT_SOURCE_DIR_NNHGE=${ENGINE}" -DNNH_BUILD_EXAMPLES=ON -DNNH_BUILD_TESTS=ON
              -DNNH_BUILD_APPS=ON -DNNH_BUILD_TOOLS=ON)
    step("listing targets" "${MAKE_PROGRAM}" -C "${BUILD}" -t targets all)
    foreach(name hello nnh_tests nnh-link nnh nnh_tool_tests)
        if(NOT step_output MATCHES "(^|\n)${name}: phony")
            message(FATAL_ERROR "consumer ${WAY}: no target '${name}' with every option ON")
        endif()
    endforeach()
    step("ctest -N" ${CMAKE_CTEST_COMMAND} --test-dir "${BUILD}" -N)
    string(REGEX MATCH "Total Tests: ([0-9]+)" _ "${step_output}")
    if(CMAKE_MATCH_1 LESS 100)
        message(FATAL_ERROR "consumer ${WAY}: ctest -N lists ${CMAKE_MATCH_1} tests, not the engine's")
    endif()
elseif(WAY STREQUAL "options_mixed") # FR-4: one part ON, the others at their game-project default (configure only)
    configure("-DFETCHCONTENT_SOURCE_DIR_NNHGE=${ENGINE}" -DNNH_BUILD_TESTS=ON -DNNH_BUILD_EXAMPLES=OFF)
    step("listing targets" "${MAKE_PROGRAM}" -C "${BUILD}" -t targets all)
    if(NOT step_output MATCHES "(^|\n)nnh_tests: phony" OR step_output MATCHES "(^|\n)(hello|nnh-link|nnh): phony")
        message(FATAL_ERROR "consumer ${WAY}: NNH_BUILD_TESTS=ON alone should add nnh_tests and nothing else optional")
    endif()
else()
    message(FATAL_ERROR "consumer: unknown WAY '${WAY}'")
endif()
if(NOT WAY STREQUAL "local")
    file(REMOVE_RECURSE "${WORK}") # one engine build each: the disk is reclaimed once a way passes
endif()
message(STATUS "consumer ${WAY}: PASS")
