# Header readers for build-time checks (include()d by nnh_check_*.cmake). Pure CMake, header bytes only.
#
#   nnh_png_size(<file> <out_width> <out_height>)        sets both to "" if the file isn't a PNG
#   nnh_wav_info(<file> <prefix>)                         sets <prefix>_ERROR ("" when fine) and
#       <prefix>_FORMAT, _CHANNELS, _RATE, _BITS, _DATA_BYTES (the data chunk's size)

function(nnh_png_size file out_w out_h)
    set(${out_w} "" PARENT_SCOPE)
    set(${out_h} "" PARENT_SCOPE)
    file(READ "${file}" head LIMIT 24 HEX)
    string(LENGTH "${head}" n)
    if(n LESS 48)
        return()
    endif()
    string(SUBSTRING "${head}" 0 16 signature)
    string(SUBSTRING "${head}" 24 8 chunk)
    if(NOT signature STREQUAL "89504e470d0a1a0a" OR NOT chunk STREQUAL "49484452")
        return()
    endif()
    # IHDR: width at bytes 16-19, height at 20-23, big endian.
    string(SUBSTRING "${head}" 32 8 w)
    string(SUBSTRING "${head}" 40 8 h)
    math(EXPR w "0x${w}")
    math(EXPR h "0x${h}")
    set(${out_w} ${w} PARENT_SCOPE)
    set(${out_h} ${h} PARENT_SCOPE)
endfunction()

# Little-endian unsigned integer of `bytes` bytes at byte `offset` (an expression) of the hex string.
function(_nnh_le_uint hex offset bytes out)
    set(value 0)
    math(EXPR last "${bytes} - 1")
    foreach(i RANGE ${last} 0 -1)
        math(EXPR at "(${offset} + ${i}) * 2")
        string(SUBSTRING "${hex}" ${at} 2 byte)
        math(EXPR value "(${value} << 8) | 0x${byte}")
    endforeach()
    set(${out} ${value} PARENT_SCOPE)
endfunction()

function(nnh_wav_info file prefix)
    set(${prefix}_ERROR "" PARENT_SCOPE)
    file(READ "${file}" head LIMIT 4096 HEX)
    string(LENGTH "${head}" hex_length)
    math(EXPR have "${hex_length} / 2")
    string(SUBSTRING "${head}" 0 8 riff)
    if(have LESS 12 OR NOT riff STREQUAL "52494646")
        set(${prefix}_ERROR "not a WAV file" PARENT_SCOPE)
        return()
    endif()
    # Walk the chunks (any order) until both `fmt ` and `data` are seen.
    set(at 12)
    set(found_fmt FALSE)
    set(data_bytes "")
    math(EXPR last "${have} - 8")
    math(EXPR fmt_room "${have} - 34") # room for a fmt chunk and its extensible fields
    while(at LESS_EQUAL last)
        math(EXPR hex_at "${at} * 2")
        string(SUBSTRING "${head}" ${hex_at} 8 id)
        _nnh_le_uint("${head}" ${at}+4 4 size)
        if(id STREQUAL "666d7420" AND at LESS_EQUAL fmt_room) # "fmt "
            math(EXPR p "${at} + 8")
            _nnh_le_uint("${head}" ${p} 2 format)
            _nnh_le_uint("${head}" ${p}+2 2 channels)
            _nnh_le_uint("${head}" ${p}+4 4 rate)
            _nnh_le_uint("${head}" ${p}+14 2 bits)
            if(format EQUAL 65534 AND size GREATER_EQUAL 40) # WAVE_FORMAT_EXTENSIBLE: the sub-format
                _nnh_le_uint("${head}" ${p}+24 2 format)
            endif()
            set(found_fmt TRUE)
        elseif(id STREQUAL "64617461") # "data"
            set(data_bytes ${size})
            break()
        endif()
        math(EXPR at "${at} + 8 + ${size} + (${size} & 1)")
    endwhile()
    if(NOT found_fmt)
        set(${prefix}_ERROR "no fmt chunk in the first 4 KB (not a WAV file?)" PARENT_SCOPE)
        return()
    endif()
    foreach(v format channels rate bits)
        string(TOUPPER ${v} V)
        set(${prefix}_${V} ${${v}} PARENT_SCOPE)
    endforeach()
    set(${prefix}_DATA_BYTES "${data_bytes}" PARENT_SCOPE)
endfunction()
