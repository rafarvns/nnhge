# ctest nnh_new_smoke (spec 033 AC-2, FR-8 to FR-10, FR-13 to FR-16; label consumer-full): a project made by `nnh new`
# in an empty folder outside the engine, built and tested the way its README says, in two ways:
#   local   NNHGE_ENGINE_DIR = this engine (a checkout nnh's project, the guard satisfied by the variable)
#   pinned  the engine packed as a file:// archive, its URL and SHA-256 pasted into CMakeLists.txt as the guard's
#           message tells a user to, NNHGE_ENGINE_DIR unset: the download a release project takes
# Each: configure pc-dev once with the parent's SDL3 download (no network), `nnh build demo --pc` (no warning in its
# output), `nnh run demo --pc --no-build --script tests/smoke.nnhs` (PASS, exit 0). The folders are deleted on success.
#   cmake -DNNH=<nnh> -DENGINE=<engine dir> -DWORK=<scratch dir> [-DSDL3_SOURCE=<dir>] [-DWAYS=local;pinned]
#         -P new_smoke.cmake
cmake_minimum_required(VERSION 3.25)
include("${CMAKE_CURRENT_LIST_DIR}/../../../tests/consumer_tools/consumer_engine.cmake")

if(NOT WAYS)
    set(WAYS local pinned)
endif()
set(ENV{SDL_VIDEO_DRIVER} offscreen)
set(ENV{SDL_RENDER_DRIVER} software)
set(ENV{NNH_SIM_RENDERER} sdl)
set(ENV{SDL_AUDIO_DRIVER} dummy)
set(ENV{CCACHE_NOHASHDIR} 1) # the compiler cache across folders (debug info holds the folder)
unset(ENV{NNH_PRESET})
set(sdl3_args "")
if(SDL3_SOURCE)
    set(sdl3_args "-DFETCHCONTENT_SOURCE_DIR_NNH_SDL3_PREBUILT=${SDL3_SOURCE}" "-DFETCHCONTENT_SOURCE_DIR_NNH_SDL3=${SDL3_SOURCE}")
endif()

function(step what dir)
    string(TIMESTAMP t0 "%s")
    execute_process(COMMAND ${ARGN} WORKING_DIRECTORY "${dir}" RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE out)
    string(TIMESTAMP t1 "%s")
    math(EXPR seconds "${t1} - ${t0}")
    if(NOT rc EQUAL 0)
        message("${out}")
        message(FATAL_ERROR "nnh_new_smoke ${way}: ${what} failed (${rc})")
    endif()
    message(STATUS "nnh_new_smoke ${way}: ${what} (${seconds} s)")
    set(step_output "${out}" PARENT_SCOPE)
endfunction()

foreach(way IN LISTS WAYS)
    set(work "${WORK}/${way}")
    file(REMOVE_RECURSE "${work}")
    file(MAKE_DIRECTORY "${work}")
    set(project "${work}/demo")
    if(way STREQUAL "local")
        set(ENV{NNHGE_ENGINE_DIR} "${ENGINE}")
        step("nnh new" "${work}" "${NNH}" new demo --engine "${ENGINE}")
    elseif(way STREQUAL "pinned")
        unset(ENV{NNHGE_ENGINE_DIR})
        step("nnh new" "${work}" "${NNH}" new demo --engine "${ENGINE}")
        consumer_pack_engine("${ENGINE}" "${work}" url sha)
        file(READ "${project}/CMakeLists.txt" text)
        string(REPLACE "set(nnhge_url \"\")" "set(nnhge_url \"${url}\")" text "${text}")
        string(REPLACE "set(nnhge_sha256 \"\")" "set(nnhge_sha256 \"${sha}\")" text "${text}")
        file(WRITE "${project}/CMakeLists.txt" "${text}")
    else()
        message(FATAL_ERROR "nnh_new_smoke: unknown way '${way}'")
    endif()
    step("configure pc-dev" "${project}" ${CMAKE_COMMAND} --preset pc-dev ${sdl3_args})
    if(way STREQUAL "pinned" AND NOT EXISTS "${project}/build/pc-dev/_deps/nnhge-src/CMakeLists.txt")
        message(FATAL_ERROR "nnh_new_smoke pinned: the engine archive was not downloaded")
    endif()
    step("nnh build demo --pc" "${project}" "${NNH}" build demo --pc)
    if(step_output MATCHES "warning:")
        message("${step_output}")
        message(FATAL_ERROR "nnh_new_smoke ${way}: a warning in the build")
    endif()
    step("the smoke script" "${project}" "${NNH}" run demo --pc --no-build --script tests/smoke.nnhs)
    if(NOT step_output MATCHES "nnh: PASS \\(")
        message("${step_output}")
        message(FATAL_ERROR "nnh_new_smoke ${way}: no 'nnh: PASS' line")
    endif()
    file(REMOVE_RECURSE "${work}") # one engine build each: the disk is reclaimed once a way passes
    message(STATUS "nnh_new_smoke ${way}: PASS")
endforeach()
