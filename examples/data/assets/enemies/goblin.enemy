# A goblin (spec 014 example). Edit a value and rebuild the assets: no C++ is recompiled.
name = "Goblin"
element = "Normal"
speed = 1.25
sprite = "art/goblin"
hurt_sound = "sfx/squish"
tint = "#7FD36A"
spawn = [40, 120]
flags = [false, false, false]   # flying, boss, undead

[stats]
hp = 30
attack = 6
defense = 2

[[drops]]
item = "items/potion"
chance = 0.5

[[drops]]
item = "items/ether"
chance = 0.1
